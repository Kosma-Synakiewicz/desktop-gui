<Window x:Class="desktop_gui_Formularz_rejestracyjny_z_walidacją.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_gui_Formularz_rejestracyjny_z_walidacją"
        mc:Ignorable="d"
        Title="Formularz Rejestracyjny" Height="500" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <!-- Styl dla pól tekstowych z walidacją -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Style.Triggers>
                <!-- Trigger sprawdzający czy pole ma błąd walidacji -->
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <!-- Wyświetlenie dymka z błędem po najechaniu myszką -->
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Szablon wyświetlający czerwony tekst błędu pod każdym polem -->
        <ControlTemplate x:Key="BladTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="ElementZBladem"/>
                <TextBlock Text="{Binding ElementName=ElementZBladem, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" 
                           Foreground="Red" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Formularz Rejestracji" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <Label Content="Imię:" Padding="0,5"/>
            <TextBox Text="{Binding Imie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                     Validation.ErrorTemplate="{StaticResource BladTemplate}"/>

            <Label Content="Nazwisko:" Padding="0,5"/>
            <TextBox Text="{Binding Nazwisko, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                     Validation.ErrorTemplate="{StaticResource BladTemplate}"/>

            <Label Content="E-mail:" Padding="0,5"/>
            <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                     Validation.ErrorTemplate="{StaticResource BladTemplate}"/>

            <Label Content="Hasło:" Padding="0,5"/>
            <!-- Hasło realizujemy jako zwykły TextBox z kropkami maskującymi ze względu na wymagania bindowania IDataErrorInfo -->
            <TextBox Text="{Binding Haslo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                     Validation.ErrorTemplate="{StaticResource BladTemplate}"/>

            <Label Content="Potwierdź hasło:" Padding="0,5"/>
            <TextBox Text="{Binding PotwierdzenieHasla, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                     Validation.ErrorTemplate="{StaticResource BladTemplate}"/>

            <CheckBox Content="Akceptuję regulamin" IsChecked="{Binding CzyRegulaminZaakceptowany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      FontSize="14" Margin="0,15,0,20" Click="CheckBox_Click"/>

            <Button Content="Zarejestruj się" FontSize="16" Padding="10" Click="Button_Zarejestruj_Click"/>
        </StackPanel>
    </Grid>
</Window>