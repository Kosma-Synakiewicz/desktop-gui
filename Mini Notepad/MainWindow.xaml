<Window x:Class="desktop_gui_mini_notepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_gui_mini_notepad"
        mc:Ignorable="d"
 Title="Mini Notepad" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top" FontSize="14" Background="#F0F0F0" Padding="2">
            <MenuItem Header="Plik" Width="600" FontWeight="Bold" HorizontalAlignment="Center">
                <MenuItem Header="Nowy" Click="Menu_Nowy_Click"/>
                <MenuItem Header="Otwórz..." Click="Menu_Otworz_Click"/>
                <MenuItem Header="Zapisz" Click="Menu_Zapisz_Click"/>
                <MenuItem Header="Zapisz jako..." Click="Menu_ZapiszJako_Click"/>
                <Separator/>
                <MenuItem Header="Zamknij" Click="Menu_Zamknij_Click"/>
            </MenuItem>
        </Menu>

        <TextBox x:Name="TextBoxNotatnika" 
                 AcceptsReturn="True" 
                 AcceptsTab="True" 
                 VerticalScrollBarVisibility="Auto" 
                 HorizontalScrollBarVisibility="Auto" 
                 FontSize="14" 
                 Padding="5" 
                 BorderThickness="0"/>
    </DockPanel>
</Window>
