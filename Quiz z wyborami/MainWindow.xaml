<Window x:Class="desktop_gui_Quiz_z_wyborami.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_gui_Quiz_z_wyborami"
        mc:Ignorable="d"
Title="Quiz .NET" Height="400" Width="520" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <DataTemplate x:Key="SzablonPytania">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Tresc}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Opcje}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding}" FontSize="14" Margin="0,6" GroupName="QuizOdpowiedzi"
                                         IsChecked="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                         Click="RadioButton_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel x:Name="PanelStartowy" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
            <TextBlock Text="Nowoczesny Quiz WPF" FontSize="26" FontWeight="Bold" Margin="0,0,0,30"/>
            <Button Content="Rozpocznij" FontSize="18" Padding="25,10" Click="BtnRozpocznij_Click" HorizontalAlignment="Center"/>
        </StackPanel>
        <Grid x:Name="PanelGry" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="TxtPostep" Text="Pytanie 1 z 3" FontSize="12" Foreground="Gray" Margin="10,0,0,0"/>
            <ContentControl Grid.Row="1" x:Name="PrezenterPytania" ContentTemplate="{StaticResource SzablonPytania}" Margin="0,10"/>

            <Button Grid.Row="2" Content="Dalej" FontSize="14" Padding="20,8" HorizontalAlignment="Right" Click="BtnDalej_Click" Margin="0,0,10,10"/>
        </Grid>

        <StackPanel x:Name="PanelWyniku" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="TxtWynik" Text="Twój wynik: 0 / 0" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,30"/>
            <Button Content="Zagraj jeszcze raz" FontSize="16" Padding="20,10" Click="BtnRestart_Click" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
 