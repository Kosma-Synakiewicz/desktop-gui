<Window x:Class="desktop_gui_Baza_kontaktów_z_bazą_danych.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_gui_Baza_kontaktów_z_bazą_danych"
        mc:Ignorable="d"
        Title="Baza Kontaktów" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header=" Dane kontaktu " Grid.Row="0" Margin="0,0,0,15" Padding="10" FontSize="13">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Imię i nazwisko:"/>
                    <TextBox x:Name="TxtImie" Width="150" Height="25"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Telefon:"/>
                    <TextBox x:Name="TxtTelefon" Width="120" Height="25"/>
                </StackPanel>
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="E-mail:"/>
                    <TextBox x:Name="TxtEmail" Width="150" Height="25"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Dodaj" Width="70" Height="25" Margin="0,0,5,0" Click="BtnDodaj_Click"/>
                    <Button Content="Zapisz" Width="70" Height="25" Margin="0,0,5,0" Click="BtnEdytuj_Click"/>
                    <Button Content="Usuń" Width="70" Height="25" Background="#FFC6C6" Click="BtnUsun_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="GridKontakty" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionMode="Single" SelectionChanged="GridKontakty_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Imię i nazwisko" Binding="{Binding Imie}" Width="*"/>
                <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="150"/>
                <DataGridTextColumn Header="Adres E-mail" Binding="{Binding Email}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
