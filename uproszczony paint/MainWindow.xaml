<Window x:Class="desktop_gui_Paint_uproszczony.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_gui_Paint_uproszczony"
        mc:Ignorable="d"
         Title="Uproszczony Paint" Height="500" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#F0F0F0">
            <TextBlock Text="Narzędzia" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <TextBlock Text="Kształt:" Margin="0,5,0,2"/>
            <ComboBox x:Name="ComboKsztalt" FontSize="14" Margin="0,0,0,15" SelectedIndex="0">
                <ComboBoxItem Content="Linia"/>
                <ComboBoxItem Content="Prostokąt"/>
                <ComboBoxItem Content="Elipsa / Koło"/>
            </ComboBox>
            <TextBlock Text="Kolor:" Margin="0,5,0,2"/>
            <ComboBox x:Name="ComboKolor" FontSize="14" Margin="0,0,0,15" SelectedIndex="0">
                <ComboBoxItem Content="Czarny"/>
                <ComboBoxItem Content="Czerwony"/>
                <ComboBoxItem Content="Niebieski"/>
                <ComboBoxItem Content="Zielony"/>
            </ComboBox>
            <TextBlock Text="Grubość pędzla:" Margin="0,5,0,2"/>
            <ComboBox x:Name="ComboGrubosc" FontSize="14" Margin="0,0,0,25" SelectedIndex="1">
                <ComboBoxItem Content="1 px"/>
                <ComboBoxItem Content="3 px"/>
                <ComboBoxItem Content="5 px"/>
                <ComboBoxItem Content="8 px"/>
            </ComboBox>

            <Button Content="Wyczyść" FontSize="14" Padding="10,5" Background="#FFD6D6" Click="BtnWyczysc_Click"/>
        </StackPanel>
        <Canvas x:Name="ObszarRysowania" Grid.Column="1" Background="White" ClipToBounds="True"
                MouseDown="ObszarRysowania_MouseDown" 
                MouseMove="ObszarRysowania_MouseMove" 
                MouseUp="ObszarRysowania_MouseUp"/>
    </Grid>
</Window>