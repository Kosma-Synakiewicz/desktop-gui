<Window x:Class="desktop_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_gui"
        mc:Ignorable="d"
        Title="Kalkulator" Height="444" Width="647" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TextBoxWynik" Grid.Row="0" Text="0" FontSize="32" TextAlignment="Right" Padding="10" Background="#F0F0F0" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="7" Grid.Row="0" Grid.Column="0" FontSize="20" Margin="2" Click="Button_Cyfra_Click"/>
            <Button Content="8" Grid.Row="0" Grid.Column="1" FontSize="20" Margin="2" Click="Button_Cyfra_Click"/>
            <Button Content="9" Grid.Row="0" Grid.Column="2" FontSize="20" Margin="2" Click="Button_Cyfra_Click"/>
            <Button Content="/" Grid.Row="0" Grid.Column="3" FontSize="20" Margin="2" Click="Button_Operator_Click"/>

            <Button Content="4" Grid.Row="1" Grid.Column="0" FontSize="20" Margin="2" Click="Button_Cyfra_Click"/>
            <Button Content="5" Grid.Row="1" Grid.Column="1" FontSize="20" Margin="2" Click="Button_Cyfra_Click"/>
            <Button Content="6" Grid.Row="1" Grid.Column="2" FontSize="20" Margin="2" Click="Button_Cyfra_Click"/>
            <Button Content="*" Grid.Row="1" Grid.Column="3" FontSize="20" Margin="2" Click="Button_Operator_Click"/>

            <Button Content="1" Grid.Row="2" Grid.Column="0" FontSize="20" Margin="2" Click="Button_Cyfra_Click"/>
            <Button Content="2" Grid.Row="2" Grid.Column="1" FontSize="20" Margin="2" Click="Button_Cyfra_Click"/>
            <Button Content="3" Grid.Row="2" Grid.Column="2" FontSize="20" Margin="2" Click="Button_Cyfra_Click"/>
            <Button Content="-" Grid.Row="2" Grid.Column="3" FontSize="20" Margin="2" Click="Button_Operator_Click"/>

            <Button Content="C" Grid.Row="3" Grid.Column="0" FontSize="20" Margin="2" Click="Button_Czysc_Click" Background="DarkRed"/>
            <Button Content="0" Grid.Row="3" Grid.Column="1" FontSize="20" Margin="2" Click="Button_Cyfra_Click"/>
            <Button Content="=" Grid.Row="3" Grid.Column="2" FontSize="20" Margin="2" Click="Button_Wynik_Click" Background="DarkOliveGreen"/>
            <Button Content="+" Grid.Row="3" Grid.Column="3" FontSize="20" Margin="2" Click="Button_Operator_Click"/>
        </Grid>
    </Grid>
</Window>
