<Window x:Class="desktop_gui_lista_zadan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_gui_lista_zadan"
        mc:Ignorable="d"
                Title="Lista zadań (To-Do List)" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TextBoxNoweZadanie" Grid.Column="0" FontSize="16" Padding="5" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <Button Content="Dodaj" Grid.Column="1" FontSize="16" Padding="15,5" Click="Button_Click" />
        </Grid>

        <ListBox x:Name="ListBoxZadania" Grid.Row="1" FontSize="16" Margin="0,0,0,10"/>

        <Button Content="Usuń zaznaczone" Grid.Row="2" FontSize="16" Padding="10" Click="Button_Click_1" />
    </Grid>
</Window>
